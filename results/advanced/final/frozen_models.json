      "vectorizer_fit": "One shared training-only vocabulary and IDF over home and away side documents.",
      "tfidf": {
        "analyzer": "word",
        "ngram_range": [
          1,
          2
        ],
        "token_pattern": "(?u)\\b\\w+(?:['’]\\w+)*\\b",
        "lowercase": true,
        "sublinear_tf": true,
        "norm": "l2",
        "min_df": 5,
        "max_df": 0.95,
        "max_features": 10000,
        "use_idf": true,
        "smooth_idf": true
