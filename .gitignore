# Data: scraped pages and downloads stay on your computer (see data/README.md)
data/*
!data/README.md
!data/processed/
data/processed/*

# Data files anywhere else (e.g. saved from a notebook) are never committed either
*.csv
*.html
*.xls
*.xlsx
*.ipynb

# ...except the text-free tables in data/processed/. They go on GitHub so the analysis
# can be re-run without scraping; tests/test_shared_data.py checks they hold no text.
!data/processed/*.csv
# ...and the result tables, which hold only numbers
!results/*.csv

# Advanced results are private by default, with exceptions for aggregate reports.
/results/advanced/**
!/results/advanced/early/
!/results/advanced/closing/
!/results/advanced/early/metadata.json
!/results/advanced/closing/metadata.json
!/results/advanced/nlp/
!/results/advanced/nlp/early/
!/results/advanced/nlp/closing/
!/results/advanced/nlp/*/metadata.json
!/results/advanced/nlp/*/metrics.csv
!/results/advanced/nlp/*/folds.csv
!/results/advanced/nlp/*/paired_log_loss.csv
!/results/advanced/nlp/*/regularization_search.csv
!/results/advanced/nlp/*/feature_diagnostics.csv
!/results/advanced/nlp/*/text_diagnostics.csv
!/results/advanced/contextual/
!/results/advanced/contextual/early/
!/results/advanced/contextual/closing/
!/results/advanced/contextual/regularization_only/
!/results/advanced/contextual/regularization_only/*/
!/results/advanced/contextual/**/metadata.json
!/results/advanced/contextual/**/metrics.csv
!/results/advanced/contextual/**/folds.csv
!/results/advanced/contextual/**/paired_log_loss.csv
!/results/advanced/contextual/**/regularization_search.csv
!/results/advanced/contextual/**/search_boundaries.csv
!/results/advanced/contextual/**/block_diagnostics.csv
!/results/advanced/contextual/**/feature_norms.csv
!/results/advanced/contextual/**/tfidf_diagnostics.csv
!/results/advanced/diagnostics/
!/results/advanced/diagnostics/metadata.json
!/results/advanced/diagnostics/report.md
!/results/advanced/diagnostics/gradient_checks.csv
!/results/advanced/diagnostics/synthetic_*.csv
!/results/advanced/diagnostics/attribution_coverage.csv
!/results/advanced/diagnostics/movement_*.csv
!/results/advanced/diagnostics/early_outcome_*.csv
!/results/advanced/diagnostics/closing_outcome_*.csv
!/results/advanced/diagnostics/early_pick_*.csv
!/results/advanced/diagnostics/closing_pick_*.csv
!/results/advanced/diagnostics/*_market_recovery.csv
!/results/advanced/diagnostics/*_folds.csv
!/results/advanced/diagnostics/*_selection.csv
!/results/advanced/diagnostics/*_learning_curves.csv
!/results/advanced/diagnostics/*_paired.csv
!/results/advanced/diagnostics/*_bootstrap.csv

# Teammates' working notes (e.g. the Kalshi PDFs), shared outside the repo
docs/docs_from_team/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/

# Environments and secrets
.venv/
venv/
.env

# Editors and OS
.vscode/
.idea/
.spyproject/
.DS_Store
Thumbs.db
